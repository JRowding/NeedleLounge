# Gmail SMTP (server-side only)
GMAIL_USER=your-bookings-address@gmail.com
GMAIL_APP_PASSWORD=replace-with-a-google-app-password

# Optional: redirects every message to one safe test inbox while testing.
GMAIL_TEST_RECIPIENT=test-recipient@example.com

# Public origin used in customer-specific links. No trailing slash.
BOOKING_BASE_URL=http://localhost:3000

# Long random server-side secret used to sign customer links.
BOOKING_LINK_SECRET=replace-with-a-long-random-secret

# Fletcher Tattoos enquiry delivery through Resend (server-side only).
AFTATTOOS_API_KEY=re_replace-with-resend-api-key
AFTATTOOS_FROM=Fletcher Tattoos <enquiries@your-verified-domain.example>
AFTATTOOS_RECIPIENT=recipient@example.com
# Keep false until the Resend sender/domain is verified and a test send is approved.
AFTATTOOS_DELIVERY_ENABLED=false
